# Drop into ~/.asoundrc on the Pi — "Set up the mic and speaker" in the build
# guide. install-claudia.sh writes this file for you with your cards filled in.
# Capture comes from the USB conversation mic (SunFounder mini or reSpeaker
# XVF3800); playback goes to the USB speaker (or the reSpeaker's own jack).
# The Pi Zero 2 has no audio jack, and HDMI is only useful with a TV attached.
#
# Replace MIC and SPEAKER with the card ids that 'arecord -l' and 'aplay -l'
# print after "card N:" (for example "Device" for the SunFounder mic). Ids,
# unlike card numbers, don't change when USB devices enumerate in another order.
# On the reSpeaker array, MIC and SPEAKER can be the same card.

pcm.!default {
    type asym
    playback.pcm "plughw:CARD=SPEAKER,DEV=0"
    capture.pcm "plughw:CARD=MIC,DEV=0"
}

ctl.!default {
    type hw
    card SPEAKER
}
