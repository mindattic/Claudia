# Drop into ~/.asoundrc on the Pi — Part 5.5 of the build guide.
# Capture comes from the USB conversation mic (SunFounder mini or reSpeaker
# XVF3800 — both are driverless USB Audio Class devices, typically card 1).
# Playback stays on the Pi's default output (card 0 — HDMI on a bare build;
# on the reSpeaker array you can point playback at its card instead and use
# its 3.5 mm jack / JST speaker output).
# If 'arecord -l' shows the mic on a different card, change hw:1,0 (and
# 'card 1') to match — or lock the mic to index 1 via
# /etc/modprobe.d/alsa-base.conf so USB enumeration order can't move it.

pcm.!default {
    type asym
    playback.pcm {
        type plug
        slave.pcm "hw:0,0"
    }
    capture.pcm {
        type plug
        slave.pcm "hw:1,0"
    }
}

ctl.!default {
    type hw
    card 1
}
