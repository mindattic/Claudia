# Claudia chatbot configuration - example .env
# install-claudia.sh writes these keys into ~/whisplay-ai-chatbot/.env for you
# (on top of upstream's own .env.template); this file shows the result so you
# can set it up by hand or check what the installer did.
# Upstream's template at github.com/PiSugar/whisplay-ai-chatbot/blob/master/.env.template
# is the source of truth for key names - diff against it after every repo update.
#
# Server-selector keys are *_SERVER (not *_PROVIDER). Upstream's plugin
# registry switches by lowercase name: see src/cloud-api/server.ts.
# Replace YOUR-USER below with your Pi username: .env files don't expand ~.

# === LLM (the AI brain) ===
LLM_SERVER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
# Upstream reads ANTHROPIC_LLM_MODEL (not ANTHROPIC_MODEL); unset, it falls
# back to its own default, a large and slow model.
ANTHROPIC_LLM_MODEL=claude-haiku-5-5
# Room for the reply plus the model's own thinking; spoken answers are short.
ANTHROPIC_MAX_TOKENS=2048
# Leave ENABLE_THINKING unset: upstream sends a fixed thinking budget, which
# current Claude models reject.

# === System prompt - shapes the assistant's voice ===
# Upstream appends its own "no Markdown, this is read aloud" instruction.
SYSTEM_PROMPT="You are Claudia, a concise, friendly voice assistant. Keep answers to one to three spoken sentences unless asked for more."

# === Speech-to-text (ASR) ===
# Upstream values: test, openai, gemini, tencent, volcengine, whisper, whisper-http,
#                  vosk, faster-whisper, llm8850whisper, hailowhisper, picovoice, aws
# 'vosk'   -> local, free, fits in the Pi Zero 2's 512 MB (default)
# 'openai' -> cloud, faster and more accurate, needs OPENAI_API_KEY
ASR_SERVER=vosk
VOSK_MODEL_PATH=/home/YOUR-USER/claudia/models/vosk-model-small-en-us-0.15

# === Text-to-speech (TTS) ===
# Upstream values: test, openai, gemini, tencent, volcengine, piper, piper-http,
#                  espeak-ng, llm8850melotts, supertonic, picovoice, aws
# 'piper'      -> local, free, clear but flat (default)
# 'openai'     -> cloud, far more natural voices (gpt-4o-mini-tts)
# 'elevenlabs' -> ONLY works if you applied the ElevenLabs patch (see build guide)
TTS_SERVER=piper
PIPER_BINARY_PATH=/home/YOUR-USER/claudia/venv/bin/piper
PIPER_MODEL_PATH=/home/YOUR-USER/claudia/piper/en_US-amy-low.onnx

# --- OpenAI sub-keys (used when ASR_SERVER=openai or TTS_SERVER=openai) ---
# OPENAI_API_KEY=sk-REPLACE-ME
# OPENAI_VOICE_MODEL=gpt-4o-mini-tts
# OPENAI_VOICE_TYPE=nova

# --- ElevenLabs sub-keys (used when TTS_SERVER=elevenlabs; requires patch) ---
# ELEVENLABS_API_KEY=sk_REPLACE_ME
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# === Wake word: the WonderEcho, through Claudia's bridge ===
# Upstream's wake listener runs WAKE_WORD_PYTHON_PATH and wakes on any stdout
# line starting with "WAKE". Pointing it at wonderecho-wake.py replaces the
# mic-based openWakeWord with the WonderEcho's own on-chip detector over I2C.
WAKE_WORD_ENABLED=true
WAKE_WORD_PYTHON_PATH=/home/YOUR-USER/claudia/wonderecho-wake.py
# Session ends after this much silence, or on one of the end keywords.
# WAKE_WORD_IDLE_TIMEOUT_SEC=60
# WAKE_WORD_END_KEYWORDS=byebye,goodbye,stop
# Bridge settings (defaults shown). Run the bridge with --watch to find the
# result ID your WonderEcho reports, then narrow WONDERECHO_WAKE_IDS to it.
# WONDERECHO_I2C_ADDR=0x34
# WONDERECHO_WAKE_IDS=any

# === Audio devices ===
# Without the Whisplay HAT, record and play through the ALSA default device,
# which ~/.asoundrc points at the USB mic and USB speaker.
ALSA_INPUT_DEVICE=default
ALSA_OUTPUT_DEVICE=default
